# Copy this file to .env and add your own key. Never commit .env.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=your-google-api-key
DATA_DIR=data

# Optional limits (defaults shown)
MAX_PAPERS=5
MAX_FILE_MB=20
MAX_PAGES=60
CHUNK_CHARS=1800
CHUNK_OVERLAP=250
RETRIEVAL_K=4
MAX_REVISIONS=2
MAX_TOOL_ROUNDS=3
MAX_LLM_CALLS=40
